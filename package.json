{
  "name": "tg_tipok_promo_bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check:env": "tsx src/scripts/check-env.ts",
    "import:codes": "tsx src/scripts/import-codes.ts",
    "campaign:create": "tsx src/scripts/create-campaign.ts",
    "check:db": "tsx src/scripts/check-db.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "reset:demo": "tsx src/scripts/reset-demo.ts",
    "export": "tsx src/scripts/export.ts",
    "draw": "tsx src/scripts/draw.ts",
    "draw:notify": "tsx src/scripts/draw-notify.ts",
    "draw:verify": "tsx src/scripts/draw-verify.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "exceljs": "4.4.0",
    "p-queue": "9.3.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "telegraf": "4.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "10.8.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "license": "UNLICENSED",
  "author": "Yatseniuk Vladyslav"
}
